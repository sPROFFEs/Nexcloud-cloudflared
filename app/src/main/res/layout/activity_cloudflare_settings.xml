<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/cloudflare_access_settings_title"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cloudflare_access_section_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/cloudflare_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/mode_disabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_mode_disabled" />

                <RadioButton
                    android:id="@+id/mode_service_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_mode_service_token" />

                <RadioButton
                    android:id="@+id/mode_interactive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_mode_interactive" />
            </RadioGroup>

            <!-- Service Token Container -->
            <LinearLayout
                android:id="@+id/service_token_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/client_id_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/cloudflare_access_client_id"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/client_id_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/client_secret_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/cloudflare_access_client_secret"
                    app:endIconMode="password_toggle"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/client_secret_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_connection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_test_connection"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_save_configuration"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_remove_credentials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_remove_credentials"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </LinearLayout>

            <!-- Interactive Login Container -->
            <LinearLayout
                android:id="@+id/interactive_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_auth_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_status_not_authenticated"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/text_session_expiration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_authenticate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_authenticate"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reauthenticate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_reauthenticate"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout_cloudflare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cloudflare_access_logout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_result_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
